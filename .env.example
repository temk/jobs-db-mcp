# Connection string for the application role: SELECT, INSERT, and UPDATE, no DDL.
JOBDBMCP_DATABASE_URL=postgresql://change-me:change-me@localhost:5432/jobdb

# Write tools (create_job, update_job) are registered only when this is set to a true value.
# Without it the server does not list them; it can still read jobs and change their status.
JOBDBMCP_ALLOW_WRITES=true

JOBDBMCP_HOST=127.0.0.1
JOBDBMCP_PORT=8000

# Read by docker-compose.yml for the two server containers.
POSTGRESQL_HOST=postgres
JOBDBMCP_RW_PORT=8101
JOBDBMCP_RO_PORT=8102
JOBDBMCP_RW_PASSWORD=change-me
JOBDBMCP_RO_PASSWORD=change-me

# Migrations need DDL rights, so Liquibase connects as a different role than the server.
LIQUIBASE_COMMAND_URL=jdbc:postgresql://localhost:5432/jobdb
LIQUIBASE_COMMAND_USERNAME=change-me
LIQUIBASE_COMMAND_PASSWORD=change-me
LIQUIBASE_COMMAND_CHANGELOG_FILE=changelog-master.yml
