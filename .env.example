# Development database: existing local PostgreSQL 17.2 container named "postgres".
JOBDBMCP_DATABASE_URL=postgresql://jobdb:change-me@127.0.0.1:5432/jobdb
# Write tools (save_job, set_job_status, set_job_score) are registered only when this
# is set to a true value. Without it the server is read-only and does not list them.
JOBDBMCP_ALLOW_WRITES=true

JOBDBMCP_HOST=127.0.0.1
JOBDBMCP_PORT=8000

# Liquibase connects as the superuser from inside the database container's network
# namespace, where connections from 127.0.0.1 are trusted and need no password.
LIQUIBASE_COMMAND_URL=jdbc:postgresql://127.0.0.1:5432/jobdb
LIQUIBASE_COMMAND_USERNAME=postgres
LIQUIBASE_COMMAND_CHANGELOG_FILE=changelog-master.yaml
