# Connection string for the application role: SELECT, INSERT, and UPDATE, no DDL.
JOBDBMCP_DATABASE_URL=postgresql://change-me:change-me@localhost:5432/jobdb

# Write tools (save_job, set_job_status, set_job_score) are registered only when this
# is set to a true value. Without it the server is read-only and does not list them.
JOBDBMCP_ALLOW_WRITES=true

JOBDBMCP_HOST=127.0.0.1
JOBDBMCP_PORT=8000

# Migrations need DDL rights, so Liquibase connects as a different role than the server.
LIQUIBASE_COMMAND_URL=jdbc:postgresql://localhost:5432/jobdb
LIQUIBASE_COMMAND_USERNAME=change-me
LIQUIBASE_COMMAND_PASSWORD=change-me
LIQUIBASE_COMMAND_CHANGELOG_FILE=changelog-master.yaml
